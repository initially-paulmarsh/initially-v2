VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (Netlify Scheduled Function — set these in Netlify site
# env vars, not exposed to the client bundle). SUPABASE_URL is the same
# value as VITE_SUPABASE_URL above. SUPABASE_SERVICE_ROLE_KEY is the
# service_role secret from Supabase Settings > API — it bypasses RLS so
# rotate-daily-puzzle can write to daily_puzzles.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
